# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://oj_user:oj_password@db:5432/oj_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=oj_db
POSTGRES_USER=oj_user
POSTGRES_PASSWORD=oj_password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Judge Core ───────────────────────────────────────────────────────────────
JUDGE_CORE_URL=http://judge-core:5050
JUDGE_REQUEST_TIMEOUT_SECONDS=20
JUDGE_GLOBAL_TIMEOUT_SECONDS=60
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_KB=262144

# ── Frontend (optional) ─────────────────────────────────────────────────────
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
